---
// Bookmarks component. Markup renders at build time; all browser-only
// behavior (localStorage) lives in the client <script> below.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  //
  // TODO (Step 3): implement the bookmarks feature here.
  //   1. On form submit, call event.preventDefault() FIRST so the page
  //      never reloads, then read and validate the original URL.
  //   2. Generate a short slug with a "mona-" prefix (for example, base62
  //      of a counter or hash → "mona-7fk2").
  //   3. Save the original URL and its slug, then persist them in the browser.
  //   4. Render each saved bookmark into #bookmark-list as a row (li.bookmark) with:
  //        - the original URL as a link (.url) that opens in a new tab,
  //        - its short slug shown as a badge (.slug), and
  //        - a "Copy" button (.copy) that copies the slug.
  //   5. Toggle empty vs. saved state: hide #empty-state and show #list-header
  //      (the "Saved bookmarks" heading + "Clear all" button) once at least one
  //      bookmark exists; reverse it when the list is empty.
  //   6. Wire the #clear-all button to remove every saved bookmark (clear the
  //      list, clear browser storage) after a quick confirm.
  //   7. On page load, read the saved bookmarks from storage and render
  //      them so the list persists across reloads.
  //
  // Because this code lives in a client <script>
  import {
    loadBookmarks,
    saveBookmarks,
    createBookmark,
    formatBookmark,
    STORAGE_KEY,
  } from '../lib/bookmarks.ts';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const empty = document.getElementById('empty-state');
  const header = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');
  const hint = document.querySelector('.hint');
  const defaultHint = hint?.innerHTML ?? '';

  const getStorage = () => {
    try { return window.localStorage; } catch { return undefined; }
  };

  let bookmarks = loadBookmarks(getStorage());

  function render() {
    if (!list) return;
    list.replaceChildren();
    for (const b of bookmarks) {
      const li = document.createElement('li');
      li.className = 'bookmark';
      li.setAttribute('aria-label', formatBookmark(b));

      const a = document.createElement('a');
      a.className = 'url';
      a.href = b.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = b.url;

      const sep = document.createElement('span');
      sep.className = 'sep';
      sep.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = b.slug;

      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'copy';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.slug);
          copy.textContent = 'Copied!';
        } catch {
          copy.textContent = 'Copy failed';
        }
        setTimeout(() => { copy.textContent = 'Copy'; }, 1500);
      });

      li.append(a, sep, slug, copy);
      list.append(li);
    }
    const has = bookmarks.length > 0;
    if (empty) empty.hidden = has;
    if (header) header.hidden = !has;
  }

  function message(text: string) {
    if (hint) hint.textContent = text;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // must stay first: stops the page from reloading
    try {
      const bookmark = createBookmark(input?.value, bookmarks);
      if (!bookmark) {
        message('That does not look like a valid web address. Try something like example.com.');
        input?.focus();
        return;
      }
      bookmarks = [...bookmarks, bookmark];
      if (!saveBookmarks(getStorage(), bookmarks)) {
        message('Saved for this visit only: your browser blocked storage.');
      } else {
        if (hint) hint.innerHTML = defaultHint;
      }
      if (input) input.value = '';
      render();
    } catch (err) {
      console.error('Could not add bookmark', err);
      message('Something went wrong adding that bookmark.');
    }
  });

  clearAll?.addEventListener('click', () => {
    if (!window.confirm('Remove all saved bookmarks?')) return;
    bookmarks = [];
    try { getStorage()?.removeItem(STORAGE_KEY); } catch { /* ignore */ }
    render();
  });

  render();
</script>